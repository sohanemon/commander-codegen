{
	"name": "commander-codegen",
	"description": "A tool to generate commander code from your tsdoc",
	"version": "0.0.2",
	"bin": {
		"commander-codegen": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"dev": "tsdown --watch",
		"execute": "bun /dist/cli.mjs",
		"build": "tsdown",
		"test:run": "vitest run --silent",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format .",
		"format:write": "biome format . --write",
		"typecheck": "tsgo --noEmit",
		"release": "tsgo --noEmit && npm run build && npm publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/bun": "latest",
		"@types/inquirer": "^9.0.10",
		"ts-morph": "^28.0.0",
		"tsdown": "^0.22.14",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"inquirer": "^14.0.2"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sohanemon/commander-codegen.git"
	},
	"keywords": [
		"cli",
		"bun",
		"commander",
		"inquirer"
	],
	"author": {
		"name": "Sohan Emon",
		"email": "sohanemon@outlook.com"
	},
	"exports": {
		".": "./dist/cli.mjs",
		"./package.json": "./package.json"
	}
}
